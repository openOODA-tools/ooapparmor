// # AppArmor Profile Generator Engine
//
// Logline: Synthesizes capability-confined AppArmor profiles from declarative contracts.
//
// Setup: Pure string formatter. Enforces zero ambient network and file authority.
//
// Beats:
//   1. Generate profile header with strict confinement flags.
//   2. Map openOODA capability tokens to precise file, device, and network rules.
//   3. Enforce negative-trust denials on undeclared capabilities.

pub fn generate_profile(tool_name: String, bin_path: String, caps_str: String) -> String {
    let target_bin: String = if bin_path != "" { bin_path } else { "/usr/bin/" + tool_name };
    let mut out: String = "# openOODA Sovereign Security Profile: " + tool_name + "\n";
    out = out + "# Autogenerated with zero ambient authority enforcement\n\n";
    out = out + "abi <abi/3.0>,\n\n";
    out = out + "include <tunables/global>\n\n";
    out = out + "profile " + tool_name + " " + target_bin + " flags=(enforce) {\n";
    out = out + "  include <abstractions/base>\n\n";

    // Binary execution
    out = out + "  " + target_bin + " mr,\n\n";

    // Capability parsing
    let has_fs_read: Bool = str_contains(caps_str, "FsRead");
    let has_fs_write: Bool = str_contains(caps_str, "FsWrite");
    let has_net: Bool = str_contains(caps_str, "Net");
    let has_process: Bool = str_contains(caps_str, "Process");

    if has_fs_read {
        out = out + "  # Bounded Read Capabilities\n";
        out = out + "  /etc/ld.so.cache r,\n";
        out = out + "  /usr/lib/** mr,\n";
        out = out + "  /usr/lib64/** mr,\n";
        out = out + "  /etc/openooda/** r,\n";
        out = out + "  owner @{HOME}/.openooda/** r,\n\n";
    }

    if has_fs_write {
        out = out + "  # Bounded Write Capabilities\n";
        out = out + "  owner @{HOME}/.cache/openooda/** rw,\n";
        out = out + "  /tmp/** rw,\n\n";
    }

    if !has_net {
        out = out + "  # Zero Ambient Network Denial\n";
        out = out + "  deny network inet,\n";
        out = out + "  deny network inet6,\n";
        out = out + "  deny network raw,\n\n";
    }

    if !has_process {
        out = out + "  # Subprocess Confinement\n";
        out = out + "  deny ptrace,\n";
        out = out + "  deny /bin/sh px,\n";
        out = out + "  deny /bin/bash px,\n\n";
    }

    out = out + "  # Standard System Citizenry\n";
    out = out + "  /dev/null rw,\n";
    out = out + "  /dev/urandom r,\n";
    out = out + "}\n";
    return out;
}
