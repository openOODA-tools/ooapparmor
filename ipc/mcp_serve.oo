// # MCP Stdio Server - AppArmor Confinement Engine
//
// Logline: Speaks Model Context Protocol over stdio for LLM coding agents.
//
// Setup: Requires FsReadCap. Dispatches apparmor_generate and apparmor_verify tools.
//
// Beats:
//   1. Handle initialize and notifications/initialized lifecycle handshakes.
//   2. Advertise apparmor_generate and apparmor_verify tools with JSON schemas.
//   3. Dispatch tools/call requests and return computed profile directives.

import "core/profile_gen.oo";
import "core/validator.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
}

fn handle_tool_call(fs: &FsReadCap, id: String, req: String) -> String {
    let params: String = json_field_raw(req, "params");
    let tool_name: String = json_field_string(params, "name");
    let args: String = json_field_raw(params, "arguments");

    if tool_name == "apparmor_generate" {
        let name: String = json_field_string(args, "tool_name");
        let bin: String = json_field_string(args, "bin_path");
        let caps: String = json_field_string(args, "caps");
        let profile: String = generate_profile(name, bin, caps);
        return build_tool_result(id, profile);
    }

    if tool_name == "apparmor_verify" {
        let content: String = json_field_string(args, "profile_content");
        let audit: AuditResult = audit_profile(content);
        let out: String = "{\"is_valid\":" + (if audit.is_valid { "true" } else { "false" })
            + ",\"enforce_mode\":" + (if audit.enforce_mode { "true" } else { "false" })
            + ",\"network_denied\":" + (if audit.network_denied { "true" } else { "false" })
            + ",\"rule_count\":" + to_string(audit.rule_count) + "}";
        return build_tool_result(id, out);
    }

    return build_error(id, -32601, "unknown tool: " + tool_name);
}

fn handle_mcp_request(fs: &FsReadCap, req: String) -> String {
    let method: String = json_field_string(req, "method");
    let raw_id: String = json_field_raw(req, "id");
    let id: String = if chars_len(raw_id) == 0 { "null" } else { raw_id };

    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"ooapparmor\",\"version\":\"0.2.0\"}}}";
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[{\"name\":\"apparmor_generate\",\"description\":\"Generate AppArmor security profile from openOODA capabilities\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"tool_name\":{\"type\":\"string\"},\"bin_path\":{\"type\":\"string\"},\"caps\":{\"type\":\"string\"}},\"required\":[\"tool_name\"]}},{\"name\":\"apparmor_verify\",\"description\":\"Audit AppArmor security profile for syntax and negative-trust containment\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"profile_content\":{\"type\":\"string\"}},\"required\":[\"profile_content\"]}}]}}";
    }
    if method == "tools/call" {
        return handle_tool_call(fs, id, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}";
    }
    return build_error(id, -32601, "method not found: " + method);
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let mut nl: Int = str_index_of(buf, "\n");
        while nl >= 0 {
            let line: String = str_trim(str_slice(buf, 0, nl));
            buf = str_slice(buf, nl + 1, chars_len(buf));
            if chars_len(line) > 0 {
                let resp: String = handle_mcp_request(fs, line);
                if chars_len(resp) > 0 {
                    println(resp);
                }
            }
            nl = str_index_of(buf, "\n");
        }

        let cr: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        if !cr.is_ok() {
            running = false;
        } else {
            let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
            }
        }
    }
    return 0;
}
